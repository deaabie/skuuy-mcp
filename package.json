{
  "name": "skuuy-mcp",
  "version": "1.1.0",
  "description": "Model Context Protocol (MCP) server for the Skuuy Tools ecosystem (IP, 2FA TOTP, Temp Mail, Proxies, DNS, TCP Ports, Public APIs, URL-to-Markdown Reader, Ephemeral File/Paste, RPC Relay)",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "skuuy-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc -w"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "skuuy",
    "ai-agents",
    "totp",
    "temp-mail",
    "proxy",
    "dns",
    "port-scanner",
    "reader",
    "rpc",
    "json-rpc",
    "web3"
  ],
  "author": "Skuuy Tools",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "typescript": "^5.7.3"
  }
}
